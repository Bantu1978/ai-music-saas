# --- Supabase : côté navigateur (exposé publiquement) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase : côté serveur uniquement (NE JAMAIS exposer) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Dashboard Supabase > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# --- Génération musicale (sunoapi.org) ---
SUNO_API_KEY=
# Optionnel : modèle Suno utilisé (V3_5, V4, V4_5...)
SUNO_MODEL=V4_5

# --- Connexion par SMS (API Orange Cameroun, remplace WhatsApp/Twilio) ---
# Orange Developer > votre app > Client ID / Client Secret
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
# Adresse expéditeur assignée par Orange, format "tel:+237XXXXXXXXX"
ORANGE_SMS_SENDER_ADDRESS=
# Secret local pour hacher les codes OTP en base (chaîne aléatoire, ex: `openssl rand -hex 32`)
OTP_HASH_SECRET=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Administration ---
# Emails autorises sur /admin, separes par des virgules. Vide = personne.
ADMIN_EMAILS=
