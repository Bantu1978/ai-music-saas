# --- Supabase : côté navigateur (exposé publiquement) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase : côté serveur uniquement (NE JAMAIS exposer) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Dashboard Supabase > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# --- Génération musicale (sunoapi.org) ---
SUNO_API_KEY=
# Optionnel : modèle Suno utilisé (V3_5, V4, V4_5...)
SUNO_MODEL=V4_5

# --- Connexion par SMS (API eSMS Verify, eSMS Africa) ---
# Dashboard eSMS Africa > API keys. esms_test_... en local, esms_live_... en prod.
ESMS_AFRICA_API_KEY=
# Dashboard eSMS Africa > Verify > votre app (format vera_xxx)
ESMS_AFRICA_APP_ID=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Administration ---
# Emails autorises sur /admin, separes par des virgules. Vide = personne.
ADMIN_EMAILS=
