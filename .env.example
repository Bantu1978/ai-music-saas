# --- Supabase : côté navigateur (exposé publiquement) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase : côté serveur uniquement (NE JAMAIS exposer) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Dashboard Supabase > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# --- Génération musicale (sunoapi.org) ---
SUNO_API_KEY=
# Optionnel : modèle Suno utilisé (V3_5, V4, V4_5...)
SUNO_MODEL=V4_5

# --- OTP par WhatsApp (API Cloud Meta, envoi direct) ---
# Meta for Developers > votre app > WhatsApp > API Setup
META_WHATSAPP_PHONE_NUMBER_ID=
# Token système permanent en prod ; le token temporaire (24h) suffit pour tester
META_WHATSAPP_ACCESS_TOKEN=
# Nom exact du template "Authentication" approuvé par Meta
META_WHATSAPP_TEMPLATE_NAME=
# Code langue du template (ex: fr, en_US) — défaut fr
META_WHATSAPP_TEMPLATE_LANGUAGE=fr
# Chaîne arbitraire que vous choisissez, à reporter aussi dans Meta > Webhooks
META_WHATSAPP_VERIFY_TOKEN=

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Administration ---
# Emails autorises sur /admin, separes par des virgules. Vide = personne.
ADMIN_EMAILS=
